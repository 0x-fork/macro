{
  "name": "@macro/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Macro SDK — a thin, namespaced client over the generated @hey-api/openapi-ts layer.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "generate": "openapi-ts",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/bun": "^1.3.5",
    "hono": "^4.12.27",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "^5.9.2"
  }
}
