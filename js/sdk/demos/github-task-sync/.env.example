# Macro API key (mk_live_...)
MACRO_API_KEY=

# Fine-grained PAT scoped to one repo with Issues read/write
GITHUB_TOKEN=

# Repository to sync, as "owner/name"
GITHUB_REPO=

# Optional: dev | prod | local (default prod)
# MACRO_ENV=dev

# Optional: seconds between sync passes (default 60)
# REFRESH_SECS=60

# Optional: SQLite file path (default sync.db)
# SYNC_DB_PATH=sync.db
