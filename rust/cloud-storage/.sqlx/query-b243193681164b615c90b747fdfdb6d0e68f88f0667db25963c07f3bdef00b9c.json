  "db_name": "PostgreSQL",
  "query": "\n        UPDATE email_messages\n        SET first_opened_at = COALESCE(first_opened_at, NOW()),\n            last_opened_at = NOW(),\n            open_count = open_count + 1\n        WHERE open_tracking_token = $1 AND is_sent = true\n        RETURNING\n            id as message_id,\n            link_id,\n            thread_id,\n            first_opened_at,\n            last_opened_at,\n            open_count\n        ",
