set dotenv-load := true

mod ci '../ci.just'

deploy-dev:
    just ci::deploy-dev authentication-service

run:
    cargo run

# Run auth service with Caddy reverse proxy for dev domain (https://auth-service-dev.macro.com)
# Note: Run 'just stop-proxy' when done to stop Caddy
run-proxied:
    echo "Starting Caddy reverse proxy on https://auth-service-dev.macro.com..."
    caddy start --config Caddyfile --adapter caddyfile
    echo "Caddy started. Starting auth service with cookie domain=macro.com..."
    echo "When done, run 'just stop-proxy' to stop Caddy"
    COOKIE_DOMAIN=macro.com cargo run

# Stop the Caddy reverse proxy
stop-proxy:
    @echo "Stopping Caddy..."
    caddy stop

check:
    SQLX_OFFLINE=true cargo check

generate_keys_dev:
    rm -rf ./output && mkdir output && cargo run --bin generate_keys dev

generate_keys_prod:
    rm -rf ./output && mkdir output && cargo run --bin generate_keys prod

create_localstack:
    docker run -d --name localstack -p 4566:4566 -e SERVICES=sqs localstack/localstack

start_localstack:
    docker run -p 4566:4566 -e SERVICES=sqs localstack/localstack

create_queue:
    AWS_REGION=us-east-1 aws --endpoint-url=http://localhost:4566 sqs create-queue --queue-name notification-queue

run-local:
    SQLX_OFFLINE=true cargo run --features macro_middleware/local_auth
