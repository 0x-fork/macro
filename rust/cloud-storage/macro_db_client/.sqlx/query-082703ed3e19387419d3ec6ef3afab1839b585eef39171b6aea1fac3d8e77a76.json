  "query": "\n        SELECT\n            id,\n            \"namespacedIdentifier\" as \"namespaced_identifier\",\n            path,\n            identifier,\n            \"createdAt\" as \"created_at\",\n            \"updatedAt\" as \"updated_at\"\n        FROM foreign_entities\n        WHERE path[1:$1] = $2\n        ORDER BY \"createdAt\" DESC\n        ",
